```mermaid
flowchart TD
    %% 实体
    User["用户"]
    Product["商品"]
    Category["商品分类"]
    Brand["品牌"]
    Order["订单"]
    OrderItem["订单项"]
    Cart["购物车"]
    Favorite["收藏"]
    Evaluation["评价"]
    Inventory["库存"]
    Permission["权限"]
    UserAddress["用户地址"]

    %% 关系
    User -->|1:N| Order
    User -->|1:N| OrderItem
    User -->|1:N| Cart
    User -->|1:N| Favorite
    User -->|1:N| Evaluation
    User -->|1:N| UserAddress
    User -->|N:N| Permission

    Product -->|1:N| OrderItem
    Product -->|1:N| Cart
    Product -->|1:N| Favorite
    Product -->|1:N| Evaluation
    Product -->|1:1| Inventory
    Product -->|N:1| Category
    Product -->|N:1| Brand

    Order -->|1:N| OrderItem
    Order -->|1:1| Evaluation
    Order -->|N:1| UserAddress

    Category -->|1:N| Product
    Brand -->|1:N| Product

    %% 样式定义
    classDef entity fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,rx:8px,ry:8px;
    classDef relationship fill:#fff3e0,stroke:#f57c00,stroke-width:2px,rx:4px,ry:4px;

    class User,Product,Category,Brand,Order,OrderItem,Cart,Favorite,Evaluation,Inventory,Permission,UserAddress entity;
```