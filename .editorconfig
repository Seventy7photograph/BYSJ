# EditorConfig 让不同编辑器落到同一套缩进与编码规则上。
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,webp,ico,pdf,woff,woff2,jar}]
insert_final_newline = false
